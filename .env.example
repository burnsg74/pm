# Copy to .env.production / .env.development as needed (all optional; defaults shown, both gitignored).

# API port (nginx proxies /api/ here in production)
PORT=4000

# Vault root and data dir (relative to VAULT_PATH). Used when NODE_ENV=production.
VAULT_PATH=/Users/greg/Library/CloudStorage/Dropbox/Notebooks/Work
DATA_DIR=10 Projects/PM/data

# Development reads ./data/dev unless DATA_PATH is set (absolute path override).
# DATA_PATH=/absolute/path/to/data/dir
